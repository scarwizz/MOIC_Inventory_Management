# ============================================================
# .env.example — Safe template. Copy to `.env` and fill in real values.
# NEVER commit your real `.env` file to version control.
# ============================================================

# ── Groq Cloud API ───────────────────────────────────────────
# Obtain your free key at: https://console.groq.com
# Used by agent_core.py to power the Llama 3.3-70b inference.
GROQ_API_KEY=your_groq_api_key_here

# ── Optional overrides ───────────────────────────────────────
# Uncomment and set if you want to switch to a different Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Future / Reserved ────────────────────────────────────────
# Add additional keys below as the project grows, e.g.:
# OPENAI_API_KEY=sk-...
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=moic-agent
